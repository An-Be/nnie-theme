{%- comment -%}
  Header navigation. Used for both the desktop column and the mobile drawer.
  Params: viewport ('desktop' | 'mobile'), section
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign hidden_titles = section.settings.hidden_links | downcase | split: ','
-%}
<nav class="header-menu-{{ viewport }}" role="navigation">
  {%- for link in menu.links -%}
    {%- liquid
      assign this_title_check = link.title | strip | downcase
      assign is_hidden = false
      if link.url == blank
        assign is_hidden = true
      endif
      for hidden_title in hidden_titles
        assign hidden_clean = hidden_title | strip
        if hidden_clean != blank and hidden_clean == this_title_check
          assign is_hidden = true
        endif
      endfor
    -%}
    {%- if is_hidden -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign is_hover_trigger = false
      if section.settings.hover_image != blank or section.settings.use_default_hover_image
        assign trigger = section.settings.hover_trigger | strip | downcase
        assign this_title = link.title | strip | downcase
        if trigger != blank and this_title == trigger
          assign is_hover_trigger = true
        endif
      endif
    -%}
    <a
      href="{{ link.url }}"
      class="header-menu-item font-bold hover-{{ link.title }}{% if link.current %} is-active{% endif %}"
      {% if is_hover_trigger and viewport == 'desktop' %}
        data-hover-trigger
      {% endif %}
      {% if viewport == 'mobile' %}
        data-aside-close-on-click
      {% endif %}
    >
      {{- link.title -}}
    </a>
  {%- endfor -%}

  {%- if section.settings.show_search -%}
    <a
      href="{{ routes.search_url }}"
      class="header-menu-item font-bold{% if request.page_type == 'search' %} is-active{% endif %}"
      {% if viewport == 'mobile' %}
        data-aside-close-on-click
      {% endif %}
    >
      {{- section.settings.search_label -}}
    </a>
  {%- endif -%}

  {%- if viewport == 'mobile' -%}
    {% render 'header-cart-link', section: section %}
  {%- endif -%}

  {%- if viewport == 'desktop' -%}
    {%- if section.settings.hover_image != blank -%}
      <div
        class="hover-image-product visible"
        data-hover-image
        {% if section.settings.hover_home_only %}
          data-home-only
        {% endif %}
        hidden
      >
        {{
          section.settings.hover_image
          | image_url: width: 1000
          | image_tag: alt: section.settings.hover_image.alt, widths: '500, 750, 1000', sizes: '500px', loading: 'lazy'
        }}
      </div>
    {%- elsif section.settings.use_default_hover_image -%}
      <div
        class="hover-image-product visible"
        data-hover-image
        {% if section.settings.hover_home_only %}
          data-home-only
        {% endif %}
        hidden
      >
        <img width="565" height="565" src="{{ 'nnie-shop-hover.jpg' | asset_url }}" alt="Shop Image" loading="lazy">
      </div>
    {%- endif -%}
  {%- endif -%}
</nav>
