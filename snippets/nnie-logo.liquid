{%- comment -%}
  Header logo. Defaults to the original inline NNIE SVGs (main + hover
  "nnie" script version), which recolor automatically per page style.
  Uploading logos in Theme settings → Logo replaces them.
{%- endcomment -%}
{%- liquid
  assign has_inverse = false
  if settings.logo_image_inverse != blank
    assign has_inverse = true
  endif
-%}
<div class="header-logo-container">
  <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {%- if settings.logo_image != blank -%}
      {{
        settings.logo_image
        | image_url: width: 1000
        | image_tag:
          class: 'header-logo main-logo header-logo-image',
          alt: shop.name,
          loading: 'eager',
          widths: '300, 500, 750, 1000'
      }}
      {%- if has_inverse -%}
        {{
          settings.logo_image_inverse
          | image_url: width: 1000
          | image_tag: class: 'header-logo main-logo header-logo-image header-logo-image--inverse', alt: shop.name
        }}
      {%- endif -%}
      {%- if settings.logo_hover_image != blank and settings.logo_hover_swap -%}
        {{
          settings.logo_hover_image
          | image_url: width: 1000
          | image_tag: class: 'header-logo alt-logo header-logo-image', alt: shop.name, loading: 'lazy'
        }}
      {%- endif -%}
    {%- else -%}
      <svg
        class="header-logo main-logo"
        xmlns="http://www.w3.org/2000/svg"
        width="144"
        height="36"
        viewBox="0 0 144 36"
        fill="black"
        role="img"
        aria-hidden="true"
      >
          <polygon points="14.56 15.61 14.56 25.02 23.72 25.02 23.72 22.73 29.32 25.02 42.04 25.02 42.04 15.61 31.35 15.61 31.35 17.64 27.28 15.61 14.56 15.61" />
          <polygon points="43.69 15.61 43.69 25.02 52.85 25.02 52.85 22.73 58.45 25.02 71.17 25.02 71.17 15.61 60.49 15.61 60.49 17.64 56.42 15.61 43.69 15.61" />
          <g>
            <rect x="72.83" y="15.54" width="27.48" height="9.41" />
            <path d="m84.02,12.36c0-1.4,1.14-2.54,2.54-2.54s2.55,1.14,2.55,2.54-1.14,2.55-2.55,2.55-2.54-1.14-2.54-2.55Z" />
          </g>
          <polygon points="114.52 18.8 114.52 19.4 128.88 19.4 128.88 21.1 114.52 21.1 114.52 21.73 129.44 21.73 129.44 25.02 101.96 25.02 101.96 15.61 129.44 15.61 129.44 18.8 114.52 18.8" />
        </svg>
      {%- if settings.logo_hover_swap -%}
        <svg
          class="header-logo alt-logo"
          xmlns="http://www.w3.org/2000/svg"
          width="144"
