{%- comment -%}
  Inline background style for a page wrapper. Uses (in order): the section's
  background image, then the page's "about_background_image" metafield (what
  the original site used), otherwise nothing. Params: section
{%- endcomment -%}
{%- liquid
  assign bg_url = blank
  if section.settings.background_image != blank
    assign bg_url = section.settings.background_image | image_url: width: 2400
  elsif section.settings.use_page_metafield and page.metafields.custom.about_background_image != blank
    assign bg_field = page.metafields.custom.about_background_image
    if bg_field.type == 'file_reference'
      assign bg_url = bg_field.value | image_url: width: 2400
    else
      assign bg_url = bg_field.value
    endif
  endif
-%}
{%- if bg_url != blank -%}
  style="background-image: url({{ bg_url }}); background-size: cover; background-position: {{ section.settings.background_position | default: 'center' }};"
{%- endif -%}
