<div class="nnie-simple-page" style="text-align: center">
  <div style="max-width: 400px; margin: 0 auto">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 600 | image_tag: style: 'width: 100%; height: auto; border-radius: 0', alt: shop.name }}
    {%- else -%}
      <h1>{{ shop.name }}</h1>
    {%- endif -%}
    <p style="margin: 2rem 0">{{ shop.password_message | default: section.settings.message }}</p>
    {%- form 'storefront_password' -%}
      <input type="password" name="password" placeholder="{{ 'general.password' | t }}" aria-label="{{ 'general.password' | t }}" style="border-radius: 0; width: 100%">
      {%- if form.errors -%}<p><small>{{ form.errors | default_errors }}</small></p>{%- endif -%}
      <button type="submit" class="nnie-button" style="margin-top: 1rem; background: #000; color: #fff">{{ 'general.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "message", "label": "Message", "default": "Opening soon." }
  ]
}
{% endschema %}
