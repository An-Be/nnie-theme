{%- comment -%}
  About page: big centered statement, two offset points with dots, photo
  behind. Everything is edited right here in the theme editor.
{%- endcomment -%}
<div class="page" {% render 'page-background-style', section: section, section_first: true %}>
  <main>
    <div class="about">
      <p class="about-header">{{ section.settings.heading | newline_to_br }}</p>
      {%- if section.blocks.size > 0 -%}
        <div class="about-points">
          {%- for block in section.blocks -%}
            <div class="about-point-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="about-circle"></div>
              <p>{{ block.settings.text | newline_to_br }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </main>
</div>

{% schema %}
{
  "name": "About",
  "max_blocks": 2,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Statement",
      "default": "A short statement about the studio."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background photo"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Photo focus",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About",
      "blocks": [
        { "type": "point", "settings": { "text": "First point" } },
        { "type": "point", "settings": { "text": "Second point" } }
      ]
    }
  ]
}
{% endschema %}
