{%- comment -%}
  About page: big centered statement, two offset points with dots, photo
  behind. Everything is edited right here in the theme editor.
{%- endcomment -%}
{%- liquid
  if section.settings.background_image != blank
    assign about_bg = section.settings.background_image | image_url: width: 2400
  else
    assign about_bg = 'nnie-about-background.jpg' | asset_url
  endif
-%}
<div
  class="page"
  style="background-image: url({{ about_bg }}); background-size: cover; background-position: {{ section.settings.background_position }};"
>
  <main>
    <div class="about">
      <p class="about-header">{{ section.settings.heading | newline_to_br }}</p>
      {%- if section.blocks.size > 0 -%}
        <div class="about-points">
          {%- for block in section.blocks -%}
            <div class="about-point-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="about-circle"></div>
              <p>{{ block.settings.text | newline_to_br }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </main>
</div>

{% schema %}
{
  "name": "About",
  "max_blocks": 2,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Statement",
      "default": "Slow-made, non-seasonal projects and ideas for the sacred act of self-decoration."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background photo",
      "info": "Leave empty to use the default NNIE photo."
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Photo focus",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About",
      "blocks": [
        { "type": "point", "settings": { "text": "Centering modular design, and play." } },
        { "type": "point", "settings": { "text": "Materials and fabric are always sourced from secondhand or deadstock suppliers. When pieces are not made in-house, we work with a local seamstress studio. We use earth friendly shipping materials and prioritize compostable or biodegradable packaging when possible." } }
      ]
    }
  ]
}
{% endschema %}
