{%- comment -%} Contact page: one big centered line over a photo, edited in the theme editor. {%- endcomment -%}
<div class="page" {% render 'page-background-style', section: section, section_first: true %}>
  <main>
    <div class="contact">
      <p>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" style="color: inherit">{{ section.settings.text }}</a>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </p>
    </div>
  </main>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "info@nnie-studio.com"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "To open an email, type mailto: followed by the address."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background photo"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Photo focus",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
