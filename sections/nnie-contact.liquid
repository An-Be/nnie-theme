{%- comment -%} Editable Contact layout: one big centered line over a photo. {%- endcomment -%}
<div class="page" {% render 'page-background-style', section: section %}>
  <main>
    <div class="contact">
      <p>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" style="color: inherit">{{ section.settings.text }}</a>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </p>
    </div>
  </main>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "info@nnie-studio.com"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "Tip: to open an email, type mailto:you@example.com"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background photo"
    },
    {
      "type": "checkbox",
      "id": "use_page_metafield",
      "label": "Otherwise use the page's own background photo",
      "default": true
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background focus",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
