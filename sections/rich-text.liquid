<div
  class="nnie-section nnie-rich-text"
  style="--section-bg: {{ section.settings.background }}; --section-text: {{ section.settings.text_color }}; --section-align: {{ section.settings.alignment }}; --section-width: {{ section.settings.width }}px; --section-padding: {{ section.settings.padding }}px;"
>
  <div class="nnie-rich-text__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <p style="margin-top: 1.5rem" {{ block.shopify_attributes }}>
              <a class="nnie-button" href="{{ block.settings.link }}" style="text-decoration: none">{{ block.settings.label }}</a>
            </p>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#670e2d" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "width", "label": "Max width", "min": 300, "max": 1200, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "padding", "label": "Space above and below", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [{ "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A heading" }]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write something here.</p>" }]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button text", "default": "SHOP" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
