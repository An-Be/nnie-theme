<div class="nnie-simple-page search">
  <h1>{{ section.settings.heading }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" aria-label="{{ section.settings.placeholder | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count == 0 -%}
        <p>{{ section.settings.no_results }}</p>
      {%- else -%}
        <div class="nnie-simple-page__grid">
          {%- for item in search.results -%}
            <a href="{{ item.url }}">
              {%- if item.featured_image -%}
                {% render 'hydrogen-image', image: item.featured_image, sizes: '(min-width: 45em) 25vw, 50vw', class: 'nnie-framed' %}
              {%- endif -%}
              <p>{{ item.title }}</p>
              {%- if item.object_type == 'product' -%}<small>{{ item.price_min | money }}</small>{%- endif -%}
            </a>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="nnie-pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Search" },
    { "type": "text", "id": "no_results", "label": "No results text", "default": "No results found." }
  ]
}
{% endschema %}
