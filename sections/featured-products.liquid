<div class="nnie-section nnie-featured" style="--section-bg: {{ section.settings.background }}; --featured-columns: {{ section.settings.columns }}; --section-padding: {{ section.settings.padding }}px;">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="nnie-featured__grid">
    {%- assign featured = section.settings.collection -%}
    {%- for product in featured.products limit: section.settings.limit -%}
      <a class="nnie-featured__item" href="{{ product.url }}">
        {% render 'hydrogen-image', image: product.featured_image, sizes: '(min-width: 45em) 25vw, 50vw', class: 'nnie-framed' %}
        <div class="flex items-start justify-between flex-wrap m-1">
          <span>{{ product.title }}</span>
          <small>{{ product.price_min | money }}</small>
        </div>
      </a>
    {%- else -%}
      <p style="font-family: var(--font-mono); font-size: 12px">Pick a collection in the section settings.</p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding", "label": "Space above and below", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
