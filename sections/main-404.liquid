<div class="nnie-simple-page route-error">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  <p><a href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a></p>
</div>

{% schema %}
{
  "name": "Page not found",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "404" },
    { "type": "text", "id": "text", "label": "Text", "default": "This page doesn't exist." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Continue shopping →" }
  ]
}
{% endschema %}
